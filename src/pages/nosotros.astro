---
// /nosotros — Historia institucional, objetivos y trayectoria
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Timeline from '../components/Timeline.astro';
import CTASection from '../components/CTASection.astro';
import { Image } from 'astro:assets';

const timelineItems = [
  { year: '2004', title: 'Fundación de la organización', description: 'Nace en Córdoba con el propósito de acompañar a personas afectadas por el consumo problemático de sustancias, con un enfoque centrado en la autonomía y el autogobierno.' },
  { year: '2007', title: 'Espacio de convivencia y talleres', description: 'Se inaugura el espacio terapéutico integral, permitiendo acompañar procesos con hábitos, talleres, psicoterapia y proyecto de vida.' },
  { year: '2010', title: 'Convenios con obras sociales', description: 'Se establecen convenios continuos con obras sociales y organismos de gobierno, ampliando el acceso al tratamiento para personas de distintos contextos.' },
  { year: '2013', title: 'Hospital de Día', description: 'Se implementa el programa de Hospital de Día como espacio estructurado de reinserción a la vida social y laboral, con 8 horas diarias de actividades y acompañamiento.' },
  { year: '2016', title: 'Unidad de prácticas UNC y UPC', description: 'La fundación se convierte en unidad de prácticas supervisadas para carreras de la Universidad Nacional de Córdoba y la Universidad Provincial de Córdoba.' },
  { year: '2019', title: 'Programa de Orientación Familiar', description: 'Se formaliza el espacio de encuentros quincenales para familias preocupadas por un ser querido, disponible aún antes de que el paciente inicie tratamiento.' },
  { year: '2022', title: 'Pacientes duales y judicializados', description: 'Se amplía la cobertura para acompañar a pacientes con trastornos duales (personalidad, psicosis, discapacidad intelectual) y casos derivados por el Superior Tribunal de Justicia de Córdoba.' },
  { year: '2024', title: '20 años de trayectoria', description: 'La fundación cumple más de 20 años de trabajo continuo con población juvenil y adulta de Córdoba y otras provincias argentinas, consolidando su equipo y su enfoque terapéutico.' },
];

const badges = [
  { label: 'Obras Sociales', svgPaths: `<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>` },
  { label: 'Superior Tribunal de Justicia de Córdoba', svgPaths: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0012 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 01-2.031.352 5.988 5.988 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 01-2.031.352 5.989 5.989 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971z"/>` },
  { label: 'UNC — Universidad Nacional de Córdoba', svgPaths: `<path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>` },
  { label: 'UPC — Universidad Provincial de Córdoba', svgPaths: `<path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342"/>` },
  { label: 'Institutos privados de Acompañamiento Terapéutico', svgPaths: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"/>` },
];

const poblacion = [
  {
    svgPaths: `<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>`,
    title: 'Trastornos por uso de sustancias',
    description: 'Personas con consumo problemático de sustancias psicoactivas (alcohol, drogas ilegales, psicofármacos), tanto judicializadas como no, de Córdoba y otras provincias argentinas.',
  },
  {
    svgPaths: `<path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0l4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0l-5.571 3-5.571-3"/>`,
    title: 'Pacientes duales',
    description: 'Personas con trastorno por uso de sustancias y un trastorno subyacente: trastorno de personalidad, psicosis o discapacidad intelectual. El tratamiento integra ambas dimensiones.',
  },
  {
    svgPaths: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0012 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 01-2.031.352 5.988 5.988 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 01-2.031.352 5.989 5.989 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971z"/>`,
    title: 'Casos judicializados',
    description: 'Derivaciones del Superior Tribunal de Justicia de la Provincia de Córdoba, con los protocolos y la confidencialidad que cada caso requiere.',
  },
  {
    svgPaths: `<path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/>`,
    title: 'Familias',
    description: 'Padres, madres, parejas y otros referentes afectivos de personas con consumo problemático, con espacios específicos para ellas aunque el paciente aún no haya iniciado tratamiento.',
  },
];
---

<PageLayout
  title="Nosotros: 20 años en salud mental"
  description="Conocé la historia, misión y objetivos institucionales de la Fundación Por Un Mundo Mejor. Más de 20 años de trabajo en salud mental y adicciones en Córdoba."
>

  <!-- Hero interior -->
  <div class="relative overflow-hidden py-20" style="background: var(--gradient-hero);">
    <div class="blob w-80 h-80 -top-20 -right-20" style="opacity: 0.15;"></div>
    <div class="container-6xl relative z-10">
      <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Nosotros' }]} />
      <div class="eyebrow mb-4">
        <span class="eyebrow-dot"></span>
        Historia institucional
      </div>
      <h1 class="font-fraunces font-black text-4xl sm:text-5xl text-white mb-4">
        Quiénes somos
      </h1>
      <p class="text-lg max-w-2xl leading-relaxed" style="color: oklch(1 0 0 / 0.72);">
        Más de 20 años de trabajo ininterrumpido con personas y familias afectadas por el consumo problemático de sustancias en Córdoba y otras provincias argentinas.
      </p>
    </div>
  </div>

  <!-- Foto institucional (banner) — aspect-ratio 16:9 fijo, nunca se deforma -->
  <div class="container-6xl pt-8">
    <div class="w-full rounded-2xl overflow-hidden shadow-soft" style="aspect-ratio: 16 / 9;">
      <Image
        src="/images/nosotros-banner.jpg"
        alt="Espacio institucional de la Fundación Por Un Mundo Mejor en Córdoba, Argentina"
        width={1600}
        height={900}
        class="w-full h-full object-cover object-center"
        loading="eager"
      />
    </div>
  </div>

  <div class="container-6xl py-16 space-y-20">

    <!-- Misión -->
    <section>
      <div class="w-full">

        <!-- Texto + blockquote + números a todo el ancho -->
        <div class="flex flex-col gap-6">
          <div>
            <div class="eyebrow mb-4">
              <span class="eyebrow-dot"></span>
              Misión institucional
            </div>
            <h2 class="font-fraunces font-bold text-3xl mb-6" style="color: var(--foreground);">Un propósito claro</h2>
            <blockquote class="rounded-2xl p-7 mb-6 italic text-base leading-relaxed" style="border-left: 4px solid var(--primary); background: color-mix(in oklch, var(--primary) 8%, var(--background)); color: var(--foreground);">
              "La Fundación por Un Mundo Mejor tiene como objeto la promoción de la salud mental y la educación integral de las poblaciones, especialmente vulnerables, y trabaja de manera primordial en pos de la autonomía y el autogobierno de las personas, desanimando el vuelco hacia alternativas de realización personal ilusorias o transitorias como el abuso de alcohol y drogas, o acompañando a quienes se han visto afectados, de regreso."
            </blockquote>
            <p class="text-sm leading-relaxed" style="color: var(--muted-fg);">
              Esta declaración de propósito no es solo un texto fundacional: es la brújula que orienta cada decisión terapéutica, cada intervención familiar y cada espacio de formación que ofrece la fundación.
            </p>
          </div>
          <!-- Tarjeta de números debajo del texto -->
          <div class="rounded-2xl p-6 text-white" style="background: var(--gradient-iso); box-shadow: var(--shadow-soft);">
            <h3 class="font-fraunces font-bold text-lg mb-4">En números</h3>
            <div class="grid grid-cols-2 gap-3">
              {[
                { label: 'Años de trayectoria', value: '20+' },
                { label: 'Modalidades de tratamiento', value: '6' },
                { label: 'Duración del proceso integral', value: '14-18 meses' },
                { label: 'Provincias con pacientes atendidos', value: 'Múltiples' },
              ].map((item) => (
                <div class="flex flex-col" style="border-bottom: 1px solid oklch(1 0 0 / 0.15); padding-bottom: 0.5rem;">
                  <span class="font-fraunces font-bold text-xl">{item.value}</span>
                  <span class="text-xs" style="color: oklch(1 0 0 / 0.75);">{item.label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Población atendida -->
    <section>
      <div class="eyebrow mb-4">
        <span class="eyebrow-dot"></span>
        A quiénes acompañamos
      </div>
      <h2 class="font-fraunces font-bold text-3xl mb-8" style="color: var(--foreground);">Población atendida</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {poblacion.map((item) => (
          <div class="card-base flex gap-5">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0" style="background: color-mix(in oklch, var(--primary) 12%, var(--background)); color: var(--primary);">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" set:html={item.svgPaths} />
            </div>
            <div>
              <h3 class="font-fraunces font-bold text-base mb-1" style="color: var(--foreground);">{item.title}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--muted-fg);">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Objetivos -->
    <section>
      <div class="eyebrow mb-4">
        <span class="eyebrow-dot"></span>
        Objetivos institucionales
      </div>
      <h2 class="font-fraunces font-bold text-3xl mb-8" style="color: var(--foreground);">Tres ejes de acción</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            num: '01',
            title: 'Objetivos Preventivos',
            items: [
              'Evitar el ingreso al consumo de drogas y alcohol',
              'Impulsar voluntariados barriales y trabajo comunitario',
              'Acompañar a niñez y adolescencia vulnerable',
              'Orientar a familias en situaciones de riesgo',
              'Favorecer la inclusión sociolaboral de jóvenes',
            ],
          },
          {
            num: '02',
            title: 'Objetivos Asistenciales',
            items: [
              'Recuperación integral: física, psíquica, intelectual y social',
              'Detección precoz e intervención oportuna',
              'Reducción de daños en situaciones de consumo activo',
              'Acompañamiento a pacientes duales y judicializados',
              'Vinculación con el sistema de salud y el entorno social',
            ],
          },
          {
            num: '03',
            title: 'Objetivos Formativos',
            items: [
              'Investigación sobre la problemática adictiva',
              'Capacitación de profesionales y equipos de salud',
              'Producción de conocimiento y divulgación comunitaria',
              'Unidad de prácticas supervisadas (UNC, UPC, institutos privados)',
              'Jornadas y cursos abiertos a la comunidad',
            ],
          },
        ].map((obj) => (
          <div class="card-base" style="background: color-mix(in oklch, var(--secondary) 30%, var(--card));">
            <div class="font-fraunces font-extrabold text-5xl mb-2" style="color: var(--primary); opacity: 0.2;">{obj.num}</div>
            <h3 class="font-fraunces font-bold text-lg mb-4" style="color: var(--foreground);">{obj.title}</h3>
            <ul class="space-y-2">
              {obj.items.map((item) => (
                <li class="flex items-start gap-2 text-sm" style="color: var(--muted-fg);">
                  <span class="w-1.5 h-1.5 rounded-full flex-shrink-0 mt-1.5" style="background: var(--primary);"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Timeline -->
    <section>
      <div class="eyebrow mb-4">
        <span class="eyebrow-dot"></span>
        Historia
      </div>
      <h2 class="font-fraunces font-bold text-3xl mb-10" style="color: var(--foreground);">20 años de trayectoria</h2>
      <div class="max-w-3xl">
        <Timeline items={timelineItems} variant="years" />
      </div>
    </section>

    <!-- Convenios -->
    <section>
      <div class="eyebrow mb-4">
        <span class="eyebrow-dot"></span>
        Alianzas
      </div>
      <h2 class="font-fraunces font-bold text-3xl mb-8" style="color: var(--foreground);">Convenios y reconocimientos</h2>
      <div class="flex flex-wrap gap-4">
        {badges.map((badge) => (
          <div class="card-base flex items-center gap-3 py-3 px-5 hover:none" style="border-radius: 1rem;">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center" style="background: color-mix(in oklch, var(--primary) 12%, var(--background)); color: var(--primary);">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" set:html={badge.svgPaths} />
            </div>
            <span class="text-sm font-semibold" style="color: var(--foreground);">{badge.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <CTASection
      title="¿Querés saber más o iniciar una consulta?"
      description="Estamos disponibles para orientarte, sin compromiso y con total confidencialidad."
      variant="gradient"
    />
  </div>
</PageLayout>
