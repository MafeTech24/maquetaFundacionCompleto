---
// /contacto — Formulario + mapa + datos de contacto
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm.astro';
import { Image } from 'astro:assets';

---

<PageLayout
  title="Contacto y ubicación en Córdoba"
  description="Contactate con la Fundación Por Un Mundo Mejor. Formulario de consulta, WhatsApp, ubicación y mapa. 27 de Abril 616, Córdoba. Teléfono: +54 9 351 671-6580."
>
  <div class="relative overflow-hidden py-20" style="background: var(--gradient-hero);">
    <div class="container-6xl relative z-10">
      <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Contacto' }]} />
      <h1 class="font-fraunces font-black text-4xl sm:text-5xl text-white mb-4">Contacto</h1>
      <p class="text-[oklch(1_0_0_/_0.72)] text-lg max-w-xl">
        El primer paso puede ser tan simple como un mensaje. Te respondemos a la brevedad con total confidencialidad.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

      <!-- Formulario -->
      <div class="lg:col-span-5">
        <h2 class="font-sora font-bold text-2xl text-gray-900 dark:text-white mb-6">Envianós un mensaje</h2>
        <ContactForm />
      </div>

      <!-- Imagen lateral vertical con proporción 5:6 original -->
      <div class="hidden lg:block lg:col-span-3">
        <div class="w-full rounded-2xl overflow-hidden shadow-soft sticky top-24" style="aspect-ratio: 5 / 6;">
          <Image
            src="/images/contacto.jpg"
            alt="Espacio de encuentro y conversación en la Fundación Por Un Mundo Mejor"
            width={1000}
            height={1200}
            class="w-full h-full object-cover"
            style="object-position: 50% 25%;"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Datos de contacto -->
      <div class="lg:col-span-4 space-y-8">

        <!-- Info de contacto -->
        <div class="bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-7">
          <h2 class="font-sora font-bold text-lg text-gray-900 dark:text-white mb-6">Información de contacto</h2>
          <div class="space-y-5">

            <!-- Dirección -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-950 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-sm text-gray-900 dark:text-white mb-0.5">Sede</p>
                {/* TODO: verificar dirección antes de publicar */}
                <p class="text-sm text-gray-600 dark:text-gray-400">27 de Abril 616<br/>Córdoba, Argentina (CP 5000)</p>
              </div>
            </div>

            <!-- Teléfono / WhatsApp -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-green-50 dark:bg-green-950 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-sm text-gray-900 dark:text-white mb-0.5">WhatsApp y llamadas</p>
                {/* TODO: verificar teléfono antes de publicar */}
                <a href="tel:+5493516716580" class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
                  +54 9 351 671-6580
                </a>
              </div>
            </div>


            <!-- Redes -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-950 flex items-center justify-center flex-shrink-0 mt-0.5">
  <svg
    class="w-5 h-5 text-brand-700 dark:text-brand-300"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <circle cx="18" cy="5" r="3" />
    <circle cx="6" cy="12" r="3" />
    <circle cx="18" cy="19" r="3" />
    <path d="m8.59 13.51 6.83 3.98" />
    <path d="m15.41 6.51-6.82 3.98" />
  </svg>
</div>
              <div>
                <p class="font-semibold text-sm text-gray-900 dark:text-white mb-2">Redes sociales</p>
                <div class="flex flex-col gap-2">
                  <!-- Instagram -->
                  <a
                    href="https://www.instagram.com/fundacion.porunmundomejor/"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Seguinos en Instagram"
                    class="flex items-center gap-2 text-sm text-brand-600 dark:text-brand-400 hover:underline"
                  >
                    <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                    Instagram
                  </a>
                  <!-- Facebook -->
                  <a
                    href="https://www.facebook.com/fundacionporunmundomejor/"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Seguinos en Facebook"
                    class="flex items-center gap-2 text-sm text-brand-600 dark:text-brand-400 hover:underline"
                  >
                    <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                    </svg>
                    Facebook
                  </a>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- Horarios -->
        <div class="bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-6">
          <h3 class="font-sora font-bold text-sm text-gray-900 dark:text-white mb-4">Atención de consultas</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
            Las consultas por WhatsApp se responden en horario de atención (lunes a viernes). Para urgencias, llamá al <strong>141 (SEDRONAR)</strong>, gratuito las 24 horas.
          </p>
        </div>
      </div>
    </div>

    <!-- Mapa embebido -->
    <div class="mt-12">
      <h2 class="font-sora font-bold text-xl text-gray-900 dark:text-white mb-5">Cómo llegarnos</h2>
      {/* TODO: verificar dirección en Google Maps antes de publicar. URL apunta a "27 de Abril 616, Córdoba, Argentina" */}
      <div class="rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-700 shadow-md" style="height: 380px;">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3404.9!2d-64.1888!3d-31.4201!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2z27+de+Abril+616,+C%C3%B3rdoba,+Argentina!5e0!3m2!1ses!2sar!4v1"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación de la Fundación Por Un Mundo Mejor — 27 de Abril 616, Córdoba"
          aria-label="Mapa de ubicación: 27 de Abril 616, Córdoba, Argentina"
        ></iframe>
      </div>
      <p class="text-xs text-gray-500 dark:text-gray-500 mt-2">
        📍 27 de Abril 616, Córdoba, Argentina (CP 5000)
      </p>
    </div>

    <!-- Disclaimer -->
    <div class="mt-12 bg-amber-50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-800 rounded-xl p-5">
      <p class="text-sm text-amber-800 dark:text-amber-300 text-center">
        ⚕️ Este sitio web no reemplaza una consulta profesional. Si estás en crisis, llamá al <strong>141</strong> (SEDRONAR, gratuito, 24 hs) o al <strong>107</strong> (urgencias médicas).
      </p>
    </div>
  </div>
</PageLayout>
