---
// /programas/hospital-de-dia
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import Icon from '../../components/Icon.astro';
import ImageCarousel from '../../components/ImageCarousel.astro';
import { Image } from 'astro:assets';

const activities = [
  { time: '8:00–9:00', activity: 'Llegada, desayuno grupal y apertura del día' },
  { time: '9:00–11:00', activity: 'Capacitación laboral práctica o micro-emprendimiento productivo' },
  { time: '11:00–12:00', activity: 'Taller de habilidades sociales o actividad cultural' },
  { time: '12:00–13:00', activity: 'Almuerzo grupal y espacio de convivencia' },
  { time: '13:00–15:00', activity: 'Psicoterapia grupal o actividad de reinserción (salidas culturales, deporte)' },
  { time: '15:00–16:00', activity: 'Espacio multifamiliar quincenal o individual' },
  { time: '16:00', activity: 'Cierre del día y regreso al hogar' },
];

const galleryImages = [
  { src: '/images/hospital-dia/hospital-dia-01-microemprendimiento.jpg', alt: 'Presentación del microemprendimiento productivo del Hospital de Día' },
  { src: '/images/hospital-dia/hospital-dia-02-productos.jpg', alt: 'Productos elaborados en el microemprendimiento del Hospital de Día' },
  { src: '/images/hospital-dia/hospital-dia-03-talleres.jpg', alt: 'Taller grupal de elaboración artesanal' },
  { src: '/images/hospital-dia/hospital-dia-04-amasado.jpg', alt: 'Participantes trabajando la masa durante un taller' },
  { src: '/images/hospital-dia/hospital-dia-05-preparacion.jpg', alt: 'Preparación grupal de productos artesanales' },
  { src: '/images/hospital-dia/hospital-dia-06-elaboracion.jpg', alt: 'Elaboración manual durante una actividad del Hospital de Día' },
  { src: '/images/hospital-dia/hospital-dia-07-pastas.jpg', alt: 'Pastas elaboradas en un taller productivo' },
  { src: '/images/hospital-dia/hospital-dia-08-huerta-cantero.jpg', alt: 'Armado de un cantero en la huerta de la Fundación' },
  { src: '/images/hospital-dia/hospital-dia-09-huerta-mantenimiento.jpg', alt: 'Trabajo de mantenimiento en la huerta' },
  { src: '/images/hospital-dia/hospital-dia-10-siembra-grupal.jpg', alt: 'Actividad grupal de preparación de almácigos' },
  { src: '/images/hospital-dia/hospital-dia-11-siembra-bandejas.jpg', alt: 'Siembra en bandejas durante un taller de huerta' },
  { src: '/images/hospital-dia/hospital-dia-12-huerta-panoramica.jpg', alt: 'Vista panorámica de la huerta de la Fundación' },
  { src: '/images/hospital-dia/hospital-dia-13-huerta-cultivo.jpg', alt: 'Participante trabajando entre los cultivos de la huerta' },
  { src: '/images/hospital-dia/hospital-dia-14-rompecabezas.jpg', alt: 'Actividad artística colaborativa con piezas de rompecabezas' },
  { src: '/images/hospital-dia/hospital-dia-15-manualidades.jpg', alt: 'Taller de pintura y manualidades al aire libre' },
  { src: '/images/hospital-dia/hospital-dia-16-manualidades-grupal.jpg', alt: 'Grupo participando de un taller de manualidades' },
  { src: '/images/hospital-dia/hospital-dia-17-encuentro-grupal.jpg', alt: 'Encuentro grupal y actividad compartida en la Fundación' },
  { src: '/images/hospital-dia/hospital-dia-18-dia-amistad.jpg', alt: 'Mensaje institucional por el Día de la Amistad' },
  { src: '/images/hospital-dia/hospital-dia-19-mural-compromiso.jpg', alt: 'Presentación grupal de un mural sobre compromiso y responsabilidad' },
  { src: '/images/hospital-dia/hospital-dia-20-cartel-compromiso.jpg', alt: 'Cartel realizado en una actividad sobre compromiso y restauración' },
];
---

<PageLayout
  title="Hospital de Día para adicciones"
  description="El Hospital de Día de la Fundación Por Un Mundo Mejor: jornada completa de 8 horas, espacio intensivo hacia la reinserción social con capacitación laboral, micro-emprendimientos y psicoterapia."
>
  <div class="relative overflow-hidden py-20" style="background: var(--gradient-hero);">
    <div class="container-6xl relative z-10">
      <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Programas', href: '/programas' }, { label: 'Hospital de Día' }]} />
      <div class="flex items-center gap-4 mb-4">
        <div class="w-14 h-14 rounded-2xl bg-brand-500/20 border border-brand-500/30 flex items-center justify-center text-primary">
          <Icon name="Sun" class="w-7 h-7" />
        </div>
        <div>
          <span class="text-brand-300 text-sm font-semibold">Jornada completa · 6 meses</span>
          <h1 class="font-heading font-extrabold text-3xl sm:text-4xl text-white">Hospital de Día</h1>
        </div>
      </div>
      <p class="text-[oklch(1_0_0_/_0.72)] text-lg max-w-2xl">Ocho horas de trabajo terapéutico real, con el apoyo del equipo y el regreso al hogar cada noche.</p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">

    <section>
      <h2 class="font-heading font-bold text-2xl text-gray-900 dark:text-white mb-4">¿Qué es el Hospital de Día?</h2>
      <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-4">
        El Hospital de Día es un <strong>programa de jornada completa (8 horas diarias)</strong> orientado a la recuperación y reinserción plena a la vida social y laboral. La persona asiste durante el día y regresa a su hogar cada noche, lo que le permite ir reconstruyendo gradualmente su vida cotidiana con el sostén del equipo.
      </p>
      <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-6">
        La jornada combina <strong>capacitación laboral práctica, micro-emprendimientos productivos, actividades culturales y deportivas, y psicoterapia</strong>, con un foco claro en la reinserción social y laboral.
      </p>
      <ImageCarousel images={galleryImages} label="Actividades del Hospital de Día" />
    </section>

    <section>
      <h2 class="font-heading font-bold text-2xl text-gray-900 dark:text-white mb-4">¿A quién está dirigido?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { icon: 'Sun', text: 'Personas que requieren una estructura intensiva de acompañamiento diurno para consolidar su proceso de recuperación (Plan A, Etapa 1).' },
          { icon: 'Activity', text: 'Personas con un nivel de compromiso en el consumo que requiere más estructura y contención diaria que el ambulatorio.' },
          { icon: 'Briefcase', text: 'Personas que perdieron inserción laboral y necesitan reconstruirla con apoyo profesional y capacitación práctica.' },
          { icon: 'Users', text: 'Personas cuyo entorno familiar puede ofrecer contención nocturna, mientras el programa garantiza el sostén diurno.' },
        ].map((item) => (
          <div class="flex gap-4 p-5 bg-white dark:bg-gray-900 rounded-xl border border-gray-100 dark:border-gray-800 items-start">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background: color-mix(in oklch, var(--primary) 12%, var(--background)); color: var(--primary);">
              <Icon name={item.icon} class="w-5 h-5" />
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed pt-1">{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="font-heading font-bold text-2xl text-gray-900 dark:text-white mb-6">Cómo es una jornada tipo</h2>
      <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-gray-800 overflow-hidden">
        {activities.map((item, i) => (
          <div class={`flex items-start gap-5 px-6 py-4 ${i % 2 === 0 ? 'bg-white dark:bg-gray-900' : 'bg-gray-50 dark:bg-gray-800/50'}`}>
            <span class="font-heading font-bold text-brand-600 dark:text-brand-400 text-xs w-24 flex-shrink-0 pt-0.5">{item.time}</span>
            <span class="text-sm text-gray-700 dark:text-gray-300">{item.activity}</span>
          </div>
        ))}
      </div>
      <p class="text-xs text-gray-500 mt-3 text-center">* El esquema varía según la etapa del proceso y las evaluaciones semanales.</p>
    </section>

    <section>
      <h2 class="font-heading font-bold text-2xl text-gray-900 dark:text-white mb-5">Componentes centrales</h2>

      
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {[
          { icon: 'Factory', title: 'Capacitación laboral', desc: 'Formación práctica en oficios y habilidades para el trabajo, con foco en la empleabilidad real.' },
          { icon: 'Sprout', title: 'Micro-emprendimientos', desc: 'Proyectos productivos grupales que combinan aprendizaje, responsabilidad y generación de ingresos.' },
          { icon: 'Vote', title: 'Asambleas de evaluación', desc: 'Reuniones semanales donde el grupo evalúa su propio proceso, celebra avances y trabaja dificultades.' },
        ].map((c) => (
          <div class="p-6 bg-white dark:bg-gray-900 rounded-xl border border-gray-100 dark:border-gray-800 text-center flex flex-col items-center">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-3" style="background: color-mix(in oklch, var(--primary) 12%, var(--background)); color: var(--primary);">
              <Icon name={c.icon} class="w-6 h-6" />
            </div>
            <h3 class="font-heading font-semibold text-sm text-gray-900 dark:text-white mb-2">{c.title}</h3>
            <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">{c.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="bg-brand-50 dark:bg-brand-950/30 border border-brand-100 dark:border-brand-900 rounded-xl p-6">
      <h3 class="font-heading font-bold text-lg text-gray-900 dark:text-white mb-2">Duración</h3>
      <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
        Aproximadamente <strong>6 meses</strong>, con evaluaciones quincenales del equipo para ajustar el ritmo según cada caso. Al finalizar, el proceso generalmente continúa con el Tratamiento Ambulatorio (Plan A, Etapa 2).
      </p>
    </div>

    <CTASection
      title="¿El Hospital de Día es la opción para tu situación?"
      description="Consultanos sin compromiso. Nuestro equipo evalúa cada caso y te orienta hacia la modalidad más adecuada."
      primaryLabel="Solicitar orientación"
      primaryHref="/contacto"
      secondaryLabel="WhatsApp"
      secondaryHref="https://wa.me/5493516716580?text=Hola%2C%20quiero%20saber%20sobre%20el%20Hospital%20de%20D%C3%ADa"
      variant="gradient"
    />

    <RelatedPages
      pages={[
        { title: 'Admisión', href: '/programas/admision', description: 'El primer paso para evaluar el ingreso a Hospital de Día.', iconName: 'ClipboardCheck' },
        { title: 'Tratamiento Ambulatorio', href: '/programas/tratamiento-ambulatorio', description: 'La siguiente etapa tras el Hospital de Día (Plan A, Etapa 2).', iconName: 'Activity' },
        { title: 'Planes de Tratamiento', href: '/planes-de-tratamiento', description: 'Ver cómo se articula el Hospital de Día en el recorrido completo.', iconName: 'ClipboardCheck' },
      ]}
    />
  </div>
</PageLayout>
