---
// /recursos/[slug] — Post individual del blog
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('recursos');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Posts relacionados (misma categoría, excluyendo el actual)
const allPosts = await getCollection('recursos');
const related = allPosts
  .filter((p) => p.slug !== post.slug && p.data.category === post.data.category)
  .slice(0, 3);
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
>
  <!-- Hero del post -->
  <div class="bg-gradient-to-br from-brand-950 to-gray-950 text-white py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: 'Inicio', href: '/' },
        { label: 'Recursos', href: '/recursos' },
        { label: post.data.title },
      ]} />
      <div class="flex flex-wrap items-center gap-3 mb-5">
        <span class="text-xs font-bold px-3 py-1 rounded-full bg-brand-500/20 border border-brand-500/30 text-brand-300">
          {post.data.category}
        </span>
        {post.data.readTime && (
          <span class="text-sm text-white/50">{post.data.readTime} de lectura</span>
        )}
      </div>
      <h1 class="font-sora font-extrabold text-3xl sm:text-4xl text-white mb-4 leading-tight">{post.data.title}</h1>
      <p class="text-white/70 text-base leading-relaxed max-w-2xl">{post.data.description}</p>
      <div class="flex items-center gap-3 mt-6 text-sm text-white/50">
        <span>{post.data.author}</span>
        <span>·</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>
    </div>
  </div>

  <!-- Contenido del post -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">

      <!-- Artículo principal -->
      <article class="lg:col-span-3">
        <div class="prose prose-base dark:prose-invert max-w-none prose-headings:font-sora prose-a:text-brand-600 dark:prose-a:text-brand-400 prose-strong:text-gray-900 dark:prose-strong:text-white">
          <Content />
        </div>

        <!-- Tags -->
        {post.data.tags.length > 0 && (
          <div class="mt-10 pt-8 border-t border-gray-100 dark:border-gray-800">
            <h3 class="font-sora font-semibold text-sm text-gray-500 dark:text-gray-400 mb-3 uppercase tracking-wide">Temas</h3>
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag: string) => (
                <span class="px-3 py-1.5 text-xs rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- CTA inline -->
        <div class="mt-12">
          <CTASection
            title="¿Tenés dudas o necesitás orientación?"
            description="Nuestro equipo está disponible para escucharte. La consulta es confidencial y sin compromiso."
            primaryLabel="Contactar"
            primaryHref="/contacto"
            secondaryLabel="WhatsApp"
            secondaryHref="https://wa.me/5493516716580?text=Hola%2C%20necesito%20informaci%C3%B3n%20sobre%20un%20tratamiento"
            variant="default"
          />
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="lg:col-span-1">
        <div class="sticky top-24 space-y-6">
          <!-- Otros artículos -->
          {related.length > 0 && (
            <div class="bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-5">
              <h3 class="font-sora font-bold text-sm text-gray-900 dark:text-white mb-4">Más artículos</h3>
              <div class="space-y-4">
                {related.map((r) => (
                  <a href={`/recursos/${r.slug}`} class="block group">
                    <span class="text-xs text-brand-600 dark:text-brand-400 font-medium">{r.data.category}</span>
                    <p class="text-sm text-gray-700 dark:text-gray-300 group-hover:text-brand-700 dark:group-hover:text-brand-300 transition-colors leading-snug mt-0.5">
                      {r.data.title}
                    </p>
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Contacto rápido -->
          <div class="bg-brand-50 dark:bg-brand-950/30 border border-brand-100 dark:border-brand-900 rounded-2xl p-5">
            <h3 class="font-sora font-bold text-sm text-gray-900 dark:text-white mb-3">¿Necesitás ayuda?</h3>
            <p class="text-xs text-gray-600 dark:text-gray-400 mb-4 leading-relaxed">
              Si lo que leíste te generó preguntas, podés escribirnos directamente.
            </p>
            <a
              href="https://wa.me/5493516716580?text=Hola%2C%20le%C3%AD%20un%20art%C3%ADculo%20y%20tengo%20una%20consulta"
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full text-center px-4 py-2.5 bg-green-500 hover:bg-green-600 text-white text-xs font-semibold rounded-lg transition-colors"
            >
              WhatsApp →
            </a>
          </div>

          <!-- Línea de crisis -->
          <div class="bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 rounded-xl p-4">
            <p class="text-xs text-amber-800 dark:text-amber-300 font-semibold mb-1">Línea de crisis</p>
            <p class="text-xs text-amber-700 dark:text-amber-400">141 (SEDRONAR) — gratuito, 24 hs</p>
          </div>
        </div>
      </aside>
    </div>

    <!-- Volver al blog -->
    <div class="mt-12 pt-8 border-t border-gray-100 dark:border-gray-800">
      <a href="/recursos" class="inline-flex items-center gap-2 text-brand-600 dark:text-brand-400 font-semibold text-sm hover:text-brand-700 dark:hover:text-brand-300 transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
        </svg>
        Volver a Recursos
      </a>
    </div>
  </div>
</PageLayout>
