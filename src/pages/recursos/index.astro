---
// /recursos — Blog institucional (índice)
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';


const posts = (await getCollection('recursos')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = [...new Set(posts.map((p) => p.data.category))];
---

<PageLayout
  title="Recursos y Blog"
  description="Artículos e información sobre prevención, tratamiento y acompañamiento en la problemática adictiva. Producción de conocimiento de la Fundación Por Un Mundo Mejor."
>
  <div class="relative overflow-hidden py-20" style="background: var(--gradient-hero);">
    <div class="container-6xl relative z-10">
      <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Recursos' }]} />
      <h1 class="font-heading font-black text-4xl sm:text-5xl text-white mb-4">Recursos y Blog</h1>
      <p class="text-[oklch(1_0_0_/_0.72)] text-lg max-w-2xl leading-relaxed">
        Artículos y material de divulgación sobre prevención, tratamiento y acompañamiento en la problemática adictiva.
      </p>
    </div>
  </div>

 


  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

    <!-- Categorías -->
    <div class="flex flex-wrap gap-2 mb-10">
      <span class="px-4 py-2 rounded-full bg-brand-600 text-white text-sm font-semibold">Todos</span>
      {categories.map((cat) => (
        <span class="px-4 py-2 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 text-sm font-medium hover:bg-brand-50 dark:hover:bg-brand-950 hover:text-brand-700 dark:hover:text-brand-300 cursor-pointer transition-colors">
          {cat}
        </span>
      ))}
    </div>

    <!-- Posts grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {posts.map((post) => (
        <article class="group bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl overflow-hidden hover:shadow-xl hover:shadow-gray-200/60 dark:hover:shadow-black/40 hover:-translate-y-1 transition-all duration-300">
          <!-- Color accent bar -->
          <div class="h-1.5 bg-gradient-to-r from-brand-500 to-teal-500"></div>
          <div class="p-7">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold px-3 py-1 rounded-full bg-brand-50 dark:bg-brand-950 text-brand-700 dark:text-brand-300 border border-brand-100 dark:border-brand-900">
                {post.data.category}
              </span>
              {post.data.readTime && (
                <span class="text-xs text-gray-400 dark:text-gray-500">{post.data.readTime} de lectura</span>
              )}
            </div>
            <h2 class="font-sora font-bold text-lg text-gray-900 dark:text-white mb-3 leading-snug group-hover:text-brand-700 dark:group-hover:text-brand-300 transition-colors duration-200">
              <a href={`/recursos/${post.slug}`}>{post.data.title}</a>
            </h2>
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mb-5">{post.data.description}</p>
            <div class="flex items-center justify-between">
              <span class="text-xs text-gray-400 dark:text-gray-500">
                {post.data.pubDate.toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
              <a
                href={`/recursos/${post.slug}`}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 transition-colors group/link"
              >
                Leer artículo
                <svg class="w-4 h-4 transition-transform duration-200 group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Tags -->
    <div class="mt-12 pt-8 border-t border-gray-100 dark:border-gray-800">
      <h2 class="font-sora font-semibold text-sm text-gray-500 dark:text-gray-400 mb-4 uppercase tracking-wide">Temas</h2>
      <div class="flex flex-wrap gap-2">
        {[...new Set(posts.flatMap((p) => p.data.tags))].map((tag) => (
          <span class="px-3 py-1.5 text-xs rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
            #{tag}
          </span>
        ))}
      </div>
    </div>
  </div>
</PageLayout>
