---
// Header.astro — Navegación global con submenú de Programas, Nosotros y dark mode toggle
import { Image } from 'astro:assets';

const navLinks = [
  { href: '/', label: 'Inicio' },
  {
    href: '/nosotros',
    label: 'Nosotros',
    children: [
      { href: '/equipo', label: 'Equipo' },
      { href: '/enfoque-terapeutico', label: 'Enfoque' },
    ],
  },
  {
    href: '/programas',
    label: 'Programas',
    children: [
      { href: '/programas/admision', label: 'Admisión' },
      { href: '/programas/hospital-de-dia', label: 'Hospital de Día' },
      { href: '/programas/psicoterapia-multifamiliar', label: 'Psicoterapia Multifamiliar' },
      { href: '/programas/tratamiento-ambulatorio', label: 'Tratamiento Ambulatorio' },
      { href: '/programas/orientacion-familiar', label: 'Orientación Familiar' },
    ],
  },
  { href: '/planes-de-tratamiento', label: 'Planes' },
  { href: '/familias', label: 'Familias' },
  { href: '/formacion', label: 'Formación' },
  { href: '/recursos', label: 'Recursos' },
  { href: '/contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
---

<header
  class="fixed top-0 left-0 right-0 z-40 backdrop-blur-md border-b transition-all duration-300"
  style="background: color-mix(in oklch, var(--background) 92%, transparent); border-color: var(--border);"
  id="site-header"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-[4.5rem]">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group" aria-label="Ir al inicio — Fundación Por Un Mundo Mejor">
        <!-- Logo real con fondo blanco circular para visibilidad en ambos modos -->
        <div
          class="w-11 h-11 rounded-full flex items-center justify-center shadow-md transition-shadow duration-300 group-hover:shadow-primary flex-shrink-0 overflow-hidden"
          style="background: #fff;"
        >
          <Image
            src="/logoFundacion.jpg"
            alt="Fundación Por Un Mundo Mejor"
            width={44}
            height={44}
            class="w-full h-full object-contain"
            loading="eager"
          />
        </div>
        <div class="hidden sm:block">
          <span class="block font-fraunces font-bold text-sm leading-tight" style="color: var(--foreground);">Fundación por</span>
          <span class="block font-fraunces font-bold text-sm leading-tight" style="color: var(--primary);">Un Mundo Mejor</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-0.5" aria-label="Navegación principal">
        {navLinks.map((link) => (
          link.children ? (
            <div class="relative group">
              <a
                href={link.href}
                class={`flex items-center gap-1 px-3 py-2 rounded-xl text-sm font-bold transition-all duration-200 ${
                  currentPath.startsWith(link.href) && link.href !== '/'
                    ? 'text-primary bg-primary/10'
                    : 'hover:bg-primary/8'
                }`}
                style={currentPath.startsWith(link.href) && link.href !== '/' ? 'color: var(--primary); background: color-mix(in oklch, var(--primary) 10%, transparent);' : 'color: var(--foreground);'}
              >
                {link.label}
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
              <!-- Dropdown -->
              <div class="absolute top-full left-0 pt-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                <div class="rounded-2xl overflow-hidden" style="background: var(--card); border: 1px solid var(--border); box-shadow: var(--shadow-card);">
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      class="flex items-center gap-3 px-4 py-3 text-sm font-semibold transition-colors duration-150"
                      style={currentPath === child.href
                        ? 'background: color-mix(in oklch, var(--primary) 10%, transparent); color: var(--primary); font-weight: 600;'
                        : 'color: var(--foreground);'}
                      onmouseover="this.style.background='color-mix(in oklch, var(--primary) 8%, transparent)'; this.style.color='var(--primary)';"
                      onmouseout={currentPath === child.href ? '' : "this.style.background=''; this.style.color='var(--foreground)';"}
                    >
                      <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background: var(--primary);"></span>
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class="px-3 py-2 rounded-xl text-sm font-bold transition-all duration-200"
              style={currentPath === link.href
                ? 'color: var(--primary); background: color-mix(in oklch, var(--primary) 10%, transparent);'
                : 'color: var(--foreground);'}
              onmouseover={currentPath !== link.href ? "this.style.background='color-mix(in oklch, var(--primary) 8%, transparent)'; this.style.color='var(--primary)';" : ''}
              onmouseout={currentPath !== link.href ? "this.style.background=''; this.style.color='var(--foreground)';" : ''}
            >
              {link.label}
            </a>
          )
        ))}
      </nav>

      <!-- Right side: dark toggle + CTA + mobile menu -->
      <div class="flex items-center gap-2">
        <!-- Dark mode toggle -->
        <button
          id="theme-toggle"
          aria-label="Cambiar tema claro/oscuro"
          class="p-2 rounded-xl transition-all duration-200"
          style="color: var(--muted-fg);"
        >
          <!-- Sun icon -->
          <svg id="icon-sun" class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon icon -->
          <svg id="icon-moon" class="w-5 h-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- CTA Button -->
        <a
          href="/contacto"
          class="hidden sm:inline-flex btn-primary text-sm py-2 px-5"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          Pedir orientación
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          class="lg:hidden p-2 rounded-xl transition-colors"
          style="color: var(--foreground);"
        >
          <svg id="icon-menu" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t" style="border-color: var(--border); background: var(--background);">
    <nav class="max-w-7xl mx-auto px-4 py-4 space-y-1" aria-label="Menú móvil">
      {navLinks.map((link) => (
        link.children ? (
          <div>
            <div class="px-3 py-2 text-xs font-bold uppercase tracking-wider" style="color: var(--primary);">{link.label}</div>
            {link.children.map((child) => (
              <a
                href={child.href}
                class="block pl-6 pr-3 py-2 rounded-xl text-sm transition-colors"
                style={currentPath === child.href
                  ? 'color: var(--primary); font-weight: 600; background: color-mix(in oklch, var(--primary) 10%, transparent);'
                  : 'color: var(--foreground);'}
              >
                {child.label}
              </a>
            ))}
          </div>
        ) : (
          <a
            href={link.href}
            class="block px-3 py-2 rounded-xl text-sm font-semibold transition-colors"
            style={currentPath === link.href
              ? 'color: var(--primary); background: color-mix(in oklch, var(--primary) 10%, transparent);'
              : 'color: var(--foreground);'}
          >
            {link.label}
          </a>
        )
      ))}
      <div class="pt-3 border-t" style="border-color: var(--border);">
        <a
          href="/contacto"
          class="block w-full text-center btn-primary text-sm py-3"
        >
          Pedir orientación
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- Header spacer -->
<div class="h-16 lg:h-[4.5rem]"></div>

<script>
  // Dark mode toggle
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Mobile menu toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  mobileBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden', isOpen);
    iconMenu?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    mobileBtn.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
