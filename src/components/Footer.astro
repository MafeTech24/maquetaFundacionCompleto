---
// Footer.astro — Footer global con sitemap, contacto y redes sociales
import { Image } from 'astro:assets';

const programLinks = [
  { href: '/programas/admision', label: 'Admisión' },
  { href: '/programas/hospital-de-dia', label: 'Hospital de Día' },
  { href: '/programas/psicoterapia-multifamiliar', label: 'Psicoterapia Multifamiliar' },
  { href: '/programas/tratamiento-ambulatorio', label: 'Tratamiento Ambulatorio' },
  { href: '/programas/orientacion-familiar', label: 'Orientación Familiar' },
];
const mainLinks = [
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/enfoque-terapeutico', label: 'Enfoque Terapéutico' },
  { href: '/planes-de-tratamiento', label: 'Planes de Tratamiento' },
  { href: '/familias', label: 'Para Familias' },
  { href: '/formacion', label: 'Formación' },
  { href: '/equipo', label: 'Nuestro Equipo' },
  { href: '/recursos', label: 'Recursos y Blog' },
  { href: '/preguntas-frecuentes', label: 'Preguntas Frecuentes' },
];
const legalLinks = [
  { href: '/contacto', label: 'Contacto' },
  { href: '/aviso-legal', label: 'Aviso Legal' },
  { href: '/privacidad', label: 'Política de Privacidad' },
];
---

<footer style="background: var(--navy); color: oklch(0.85 0.01 210);">
  <!-- Main footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 pb-12" style="border-bottom: 1px solid oklch(1 0 0 / 0.12);">

      <!-- Brand col -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-5 group">
          <div
            class="w-10 h-10 rounded-full flex items-center justify-center shadow-md flex-shrink-0 overflow-hidden"
            style="background: #fff;"
          >
            <Image
              src="/logoFundacion.jpg"
              alt="Fundación Por Un Mundo Mejor"
              width={40}
              height={40}
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
          <div>
            <span class="block font-fraunces font-bold text-white text-sm leading-tight">Fundación por</span>
            <span class="block font-fraunces font-bold text-sm leading-tight" style="color: var(--mint);">Un Mundo Mejor</span>
          </div>
        </a>
        <p class="text-sm leading-relaxed mb-5" style="color: oklch(0.80 0.01 210);">
          Fundación para el tratamiento y prevención de las adicciones. Más de 20 años acompañando personas y familias en Córdoba, Argentina.
        </p>
        <!-- Redes sociales -->
        <div class="flex gap-3">
          <a
            href="https://www.instagram.com/fundacion.porunmundomejor/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de la Fundación"
            class="w-9 h-9 rounded-xl flex items-center justify-center transition-all duration-200 hover:-translate-y-0.5"
            style="background: oklch(1 0 0 / 0.12);"
            onmouseover="this.style.background='var(--primary)';"
            onmouseout="this.style.background='oklch(1 0 0 / 0.12)';"
          >
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href="https://www.facebook.com/fundacionporunmundomejor/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook de la Fundación"
            class="w-9 h-9 rounded-xl flex items-center justify-center transition-all duration-200 hover:-translate-y-0.5"
            style="background: oklch(1 0 0 / 0.12);"
            onmouseover="this.style.background='var(--primary)';"
            onmouseout="this.style.background='oklch(1 0 0 / 0.12)';"
          >
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a
            href="https://wa.me/5493516716580?text=Hola%2C%20necesito%20informaci%C3%B3n%20sobre%20un%20tratamiento"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp de la Fundación"
            class="w-9 h-9 rounded-xl flex items-center justify-center transition-all duration-200 hover:-translate-y-0.5"
            style="background: oklch(1 0 0 / 0.12);"
            onmouseover="this.style.background='#25d366';"
            onmouseout="this.style.background='oklch(1 0 0 / 0.12)';"
          >
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Programas col -->
      <div>
        <h3 class="font-fraunces font-bold text-white mb-4 text-sm uppercase tracking-wide">Programas</h3>
        <ul class="space-y-2.5">
          {programLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm transition-colors duration-200 hover:text-white" style="color: oklch(0.80 0.01 210);">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Institución col -->
      <div>
        <h3 class="font-fraunces font-bold text-white mb-4 text-sm uppercase tracking-wide">Institución</h3>
        <ul class="space-y-2.5">
          {mainLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm transition-colors duration-200 hover:text-white" style="color: oklch(0.80 0.01 210);">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contacto col -->
      <div>
        <h3 class="font-fraunces font-bold text-white mb-4 text-sm uppercase tracking-wide">Contacto</h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <!-- MapPin icon -->
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0" style="color: var(--mint);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="text-sm" style="color: oklch(0.80 0.01 210);">27 de Abril 616<br/>Córdoba, Argentina (CP 5000)</span>
          </li>
          <li class="flex items-center gap-3">
            <!-- Phone icon -->
            <svg class="w-4 h-4 flex-shrink-0" style="color: var(--mint);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href="tel:+5493516716580" class="text-sm transition-colors hover:text-white" style="color: oklch(0.80 0.01 210);">
              +54 9 351 671-6580
            </a>
          </li>
          <li class="flex items-center gap-3">
            <!-- MessageCircle icon -->
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color: #25d366;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            <a
              href="https://wa.me/5493516716580?text=Hola%2C%20necesito%20informaci%C3%B3n%20sobre%20un%20tratamiento"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm transition-colors hover:text-white"
              style="color: oklch(0.80 0.01 210);"
            >
              Escribir por WhatsApp
            </a>
          </li>
        </ul>

        <div class="mt-6">
          <a href="/contacto" class="btn-primary text-sm py-2.5 px-5">
            Solicitar orientación →
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-center sm:text-left" style="color: oklch(0.75 0.01 210);">
        © {new Date().getFullYear()} Fundación Por Un Mundo Mejor · Córdoba, Argentina · Todos los derechos reservados.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        {legalLinks.map((link) => (
          <a href={link.href} class="text-xs transition-colors hover:text-white" style="color: oklch(0.75 0.01 210);">
            {link.label}
          </a>
        ))}
      </div>
    </div>
    <p class="mt-4 text-xs text-center flex items-center justify-center gap-2" style="color: oklch(0.70 0.01 210);">
      <!-- Stethoscope / health icon -->
      <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
      </svg>
      Este sitio no reemplaza una consulta profesional. Si estás en crisis, llamá al 141 (SEDRONAR) o al 0800-999-0800.
    </p>
  </div>
</footer>

