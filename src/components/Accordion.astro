---
// Accordion.astro — Accordion accesible, funciona sin JS (details/summary)
export interface Props {
  items: { question: string; answer: string }[];
  className?: string;
}
const { items, className = '' } = Astro.props;
---

<div class={`space-y-3 ${className}`}>
  {items.map((item) => (
    <details
      class="group rounded-2xl overflow-hidden transition-all duration-200"
      style="border: 1px solid var(--border); background: var(--card);"
    >
      <summary
        class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none select-none font-fraunces font-semibold text-sm sm:text-base"
        style="color: var(--foreground);"
      >
        <span>{item.question}</span>
        <span
          class="flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center transition-all duration-200 group-open:rotate-45"
          style="background: color-mix(in oklch, var(--primary) 12%, transparent); color: var(--primary);"
        >
          <svg class="w-4 h-4 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
        </span>
      </summary>
      <div class="px-5 pb-5 pt-1 text-sm leading-relaxed" style="border-top: 1px solid var(--border); color: var(--muted-fg);">
        <p set:html={item.answer} />
      </div>
    </details>
  ))}
</div>
