---
// Breadcrumbs.astro — Migas de pan accesibles
export interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Migas de pan" class="flex items-center gap-2 text-sm mb-6 flex-wrap">
  {items.map((item, i) => (
    <span class="flex items-center gap-2">
      {i > 0 && (
        <svg class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" style="color: oklch(1 0 0 / 0.40);">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      )}
      {item.href && i < items.length - 1 ? (
        <a href={item.href} class="transition-colors hover:text-white font-medium" style="color: oklch(1 0 0 / 0.70);">{item.label}</a>
      ) : (
        <span class={i === items.length - 1 ? 'font-semibold' : ''} style={i === items.length - 1 ? 'color: oklch(1 0 0 / 0.95);' : 'color: oklch(1 0 0 / 0.70);'}>{item.label}</span>
      )}
    </span>
  ))}
</nav>

