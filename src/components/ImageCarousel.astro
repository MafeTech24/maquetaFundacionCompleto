---
interface CarouselImage {
  src: string;
  alt: string;
}

interface Props {
  images: CarouselImage[];
  label?: string;
}

const { images, label = 'Galería de actividades' } = Astro.props;
---

<section class="image-carousel" data-image-carousel aria-label={label} tabindex="0">
  <div class="image-carousel__viewport">
    {images.map((image, index) => (
      <figure
        class="image-carousel__slide"
        data-carousel-slide
        hidden={index !== 0}
        aria-hidden={index !== 0 ? 'true' : 'false'}
      >
        <img
          src={image.src}
          alt={image.alt}
          width="1080"
          height="1080"
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />
      </figure>
    ))}

    <button class="image-carousel__arrow image-carousel__arrow--previous" type="button" data-carousel-previous aria-label="Ver imagen anterior">
      <span aria-hidden="true">&#8249;</span>
    </button>
    <button class="image-carousel__arrow image-carousel__arrow--next" type="button" data-carousel-next aria-label="Ver imagen siguiente">
      <span aria-hidden="true">&#8250;</span>
    </button>

    <div class="image-carousel__counter" aria-live="polite">
      <span data-carousel-current>1</span> / {images.length}
    </div>
  </div>

  <div class="image-carousel__thumbnails" role="group" aria-label="Elegir una imagen">
    {images.map((image, index) => (
      <button
        class="image-carousel__thumbnail"
        type="button"
        data-carousel-thumbnail
        data-index={index}
        aria-label={`Ver imagen ${index + 1} de ${images.length}`}
        aria-current={index === 0 ? 'true' : 'false'}
      >
        <img src={image.src} alt="" width="96" height="96" loading="lazy" decoding="async" />
      </button>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll('[data-image-carousel]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll('[data-carousel-slide]'));
    const thumbnails = Array.from(carousel.querySelectorAll('[data-carousel-thumbnail]'));
    const previous = carousel.querySelector('[data-carousel-previous]');
    const next = carousel.querySelector('[data-carousel-next]');
    const current = carousel.querySelector('[data-carousel-current]');
    const viewport = carousel.querySelector('.image-carousel__viewport');
    let activeIndex = 0;
    let pointerStart = 0;

    const showSlide = (index) => {
      activeIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeIndex;
        slide.toggleAttribute('hidden', !isActive);
        slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });

      thumbnails.forEach((thumbnail, thumbnailIndex) => {
        thumbnail.setAttribute('aria-current', thumbnailIndex === activeIndex ? 'true' : 'false');
      });

      if (current) current.textContent = String(activeIndex + 1);
      thumbnails[activeIndex]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    };

    previous?.addEventListener('click', () => showSlide(activeIndex - 1));
    next?.addEventListener('click', () => showSlide(activeIndex + 1));

    thumbnails.forEach((thumbnail) => {
      thumbnail.addEventListener('click', () => showSlide(Number(thumbnail.dataset.index)));
    });

    carousel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        showSlide(activeIndex - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        showSlide(activeIndex + 1);
      }
      if (event.key === 'Home') {
        event.preventDefault();
        showSlide(0);
      }
      if (event.key === 'End') {
        event.preventDefault();
        showSlide(slides.length - 1);
      }
    });

    viewport?.addEventListener('pointerdown', (event) => {
      pointerStart = event.clientX;
    });

    viewport?.addEventListener('pointerup', (event) => {
      const distance = event.clientX - pointerStart;
      if (Math.abs(distance) < 50) return;
      showSlide(activeIndex + (distance < 0 ? 1 : -1));
    });
  });
</script>

<style>
  .image-carousel {
    width: 100%;
    outline: none;
  }

  .image-carousel:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 6px;
    border-radius: 1rem;
  }

  .image-carousel__viewport {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 1rem;
    background: color-mix(in oklch, var(--navy) 92%, black);
    box-shadow: var(--shadow-soft);
    touch-action: pan-y;
  }

  .image-carousel__slide {
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .image-carousel__slide[hidden] {
    display: none;
  }

  .image-carousel__slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .image-carousel__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid oklch(1 0 0 / 0.35);
    border-radius: 9999px;
    background: oklch(0.15 0.03 230 / 0.72);
    color: white;
    cursor: pointer;
    transform: translateY(-50%);
    transition: background 0.2s ease, transform 0.2s ease;
    backdrop-filter: blur(8px);
  }

  .image-carousel__arrow:hover {
    background: var(--primary);
    transform: translateY(-50%) scale(1.05);
  }

  .image-carousel__arrow span {
    display: block;
    font-size: 2rem;
    line-height: 0.8;
    transform: translateY(-0.08rem);
  }

  .image-carousel__arrow--previous {
    left: 0.875rem;
  }

  .image-carousel__arrow--next {
    right: 0.875rem;
  }

  .image-carousel__counter {
    position: absolute;
    right: 0.875rem;
    bottom: 0.875rem;
    z-index: 2;
    min-width: 4.25rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid oklch(1 0 0 / 0.24);
    border-radius: 9999px;
    background: oklch(0.15 0.03 230 / 0.75);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    text-align: center;
    backdrop-filter: blur(8px);
  }

  .image-carousel__thumbnails {
    display: flex;
    gap: 0.625rem;
    overflow-x: auto;
    padding: 0.75rem 0.125rem 0.25rem;
    scrollbar-width: thin;
  }

  .image-carousel__thumbnail {
    width: 4.25rem;
    height: 4.25rem;
    flex: 0 0 auto;
    overflow: hidden;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 0.75rem;
    background: var(--muted);
    cursor: pointer;
    opacity: 0.62;
    transition: border-color 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
  }

  .image-carousel__thumbnail:hover {
    opacity: 0.9;
  }

  .image-carousel__thumbnail[aria-current='true'] {
    border-color: var(--primary);
    opacity: 1;
    transform: translateY(-2px);
  }

  .image-carousel__thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 639px) {
    .image-carousel__viewport {
      aspect-ratio: 1 / 1;
    }

    .image-carousel__arrow {
      width: 2.4rem;
      height: 2.4rem;
    }

    .image-carousel__arrow--previous {
      left: 0.5rem;
    }

    .image-carousel__arrow--next {
      right: 0.5rem;
    }

    .image-carousel__thumbnail {
      width: 3.75rem;
      height: 3.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-carousel__arrow,
    .image-carousel__thumbnail {
      transition: none;
    }
  }
</style>
