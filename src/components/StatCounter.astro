---
// StatCounter.astro — Estadísticas institucionales con íconos Lucide
export interface Props {
  stats: { value: string; label: string; icon?: string; iconName?: string }[];
}
const { stats } = Astro.props;

// SVG paths para cada ícono
const iconSvgMap: Record<string, string> = {
  'Building2': `<path stroke-linecap="round" stroke-linejoin="round" d="M6 22V4a2 2 0 012-2h8a2 2 0 012 2v18"/><path stroke-linecap="round" stroke-linejoin="round" d="M6 12H4a2 2 0 00-2 2v6a2 2 0 002 2h2"/><path stroke-linecap="round" stroke-linejoin="round" d="M18 9h2a2 2 0 012 2v9a2 2 0 01-2 2h-2"/><path stroke-linecap="round" stroke-linejoin="round" d="M10 6h4M10 10h4M10 14h4M10 18h4"/>`,
  'LayoutGrid': `<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>`,
  'Clock': `<circle cx="12" cy="12" r="10"/><polyline stroke-linecap="round" stroke-linejoin="round" points="12 6 12 12 16 14"/>`,
  'Lock': `<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0110 0v4"/>`,
  // emoji fallbacks
  '🏛️': `<path stroke-linecap="round" stroke-linejoin="round" d="M6 22V4a2 2 0 012-2h8a2 2 0 012 2v18"/><path stroke-linecap="round" stroke-linejoin="round" d="M6 12H4a2 2 0 00-2 2v6a2 2 0 002 2h2"/><path stroke-linecap="round" stroke-linejoin="round" d="M18 9h2a2 2 0 012 2v9a2 2 0 01-2 2h-2"/>`,
  '🔄': `<polyline stroke-linecap="round" stroke-linejoin="round" points="23 4 23 10 17 10"/><polyline stroke-linecap="round" stroke-linejoin="round" points="1 20 1 14 7 14"/><path stroke-linecap="round" stroke-linejoin="round" d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>`,
  '📅': `<circle cx="12" cy="12" r="10"/><polyline stroke-linecap="round" stroke-linejoin="round" points="12 6 12 12 16 14"/>`,
  '🔒': `<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0110 0v4"/>`,
};
---

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
  {stats.map((stat) => {
    const key = stat.iconName ?? stat.icon ?? '';
    const svgPaths = iconSvgMap[key] ?? iconSvgMap['Lock'];
    return (
      <div
        class="group text-center card-base flex flex-col items-center py-6 px-4"
      >
        <div
          class="w-12 h-12 rounded-2xl flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform duration-300"
          style="background: color-mix(in oklch, var(--primary) 12%, var(--background)); color: var(--primary);"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true" set:html={svgPaths} />
        </div>
        <div class="font-fraunces font-extrabold text-3xl sm:text-4xl leading-none mb-1" style="color: var(--primary);">
          {stat.value}
        </div>
        <div class="text-sm leading-tight" style="color: var(--muted-fg);">
          {stat.label}
        </div>
      </div>
    );
  })}
</div>
