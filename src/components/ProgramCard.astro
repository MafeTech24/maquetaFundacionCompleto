---
// ProgramCard.astro — Card para modalidades de tratamiento
import Icon from './Icon.astro';

export interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
  iconName?: string;
  duration?: string;
  badge?: string;
  color?: string;
}
const {
  title,
  description,
  href,
  icon,
  iconName,
  duration,
  badge,
} = Astro.props;

// Mapeo semántico a íconos Lucide
const programIconMap: Record<string, string> = {
  'Admisión': 'ClipboardCheck',
  'Hospital de Día': 'Sun',
  'Psicoterapia Multifamiliar': 'Users',
  'Tratamiento Ambulatorio': 'Activity',
  'Orientación Familiar': 'HeartHandshake',
};

const resolvedIconName = iconName
  ?? (title ? programIconMap[title] : undefined)
  ?? icon
  ?? 'ClipboardCheck';
---

<article class="group relative flex flex-col card-base overflow-hidden">
  <!-- Top accent gradient -->
  <div class="absolute top-0 left-0 right-0 h-1 rounded-t-3xl" style="background: var(--gradient-iso); opacity: 0.8;"></div>

  <div class="flex flex-col flex-1 pt-2">
    <!-- Icon + badge -->
    <div class="flex items-start justify-between mb-5">
      <div
        class="w-12 h-12 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
        style="background: color-mix(in oklch, var(--primary) 12%, var(--background)); color: var(--primary);"
      >
        <Icon name={resolvedIconName} class="w-6 h-6" />
      </div>
      {badge && (
        <span class="eyebrow text-[0.65rem]">
          <span class="eyebrow-dot"></span>
          {badge}
        </span>
      )}
    </div>

    <h3 class="font-fraunces font-bold text-lg mb-2 leading-snug transition-colors duration-200 group-hover:text-primary" style="color: var(--foreground);">
      {title}
    </h3>

    <p class="text-sm leading-relaxed flex-1 mb-4" style="color: var(--muted-fg);">
      {description}
    </p>

    {duration && (
      <div class="flex items-center gap-2 text-xs mb-4" style="color: var(--muted-fg);">
        <!-- Clock icon -->
        <svg class="w-3.5 h-3.5" style="color: var(--primary);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <polyline stroke-linecap="round" stroke-linejoin="round" points="12 6 12 12 16 14"/>
        </svg>
        {duration}
      </div>
    )}

    <a
      href={href}
      class="inline-flex items-center gap-2 text-sm font-bold transition-all duration-200 group/link"
      style="color: var(--primary);"
    >
      Ver más detalles
      <svg class="w-4 h-4 transition-transform duration-200 group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</article>
