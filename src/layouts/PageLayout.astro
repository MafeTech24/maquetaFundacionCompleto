---
// PageLayout.astro — Layout completo con Header y Footer incluidos
// Usar este layout en todas las páginas .astro
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  schema?: object;
}

const props = Astro.props;
---

<Layout {...props}>
  <Header slot="header" />
  <slot />
  <Footer slot="footer" />
</Layout>
